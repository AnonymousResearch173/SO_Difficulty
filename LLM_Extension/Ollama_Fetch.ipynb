# You need to get an API key from https://ollama.com/signup
OLLAMA_API_KEY = "*************"  # Replace with your actual API key

# Ollama Cloud API endpoint
OLLAMA_CLOUD_URL = "https://ollama.com/api/generate"

# Model to use
MODEL_NAME = "qwen3-coder-next:cloud"

def query_ollama_cloud(prompt: str, model_name: str = MODEL_NAME, temperature: float = 0.1) -> tuple:
    """Send query to Ollama Cloud directly via HTTP API"""

    headers = {
        "Authorization": f"Bearer {OLLAMA_API_KEY}",
        "Content-Type": "application/json"
    }

    payload = {
        "model": model_name,
        "prompt": prompt,
        "stream": False,
        "options": {
            "temperature": temperature,
            "num_predict": 512,  # Reduced since we only need difficulty
            "num_ctx": 4096
        }
    }

    try:
        response = requests.post(
            OLLAMA_CLOUD_URL,
            json=payload,
            headers=headers,
            timeout=120
        )

        if response.status_code == 200:
            response_data = response.json()
            return response_data.get('response', ''), True
        elif response.status_code == 401:
            print(f"Authentication failed! Please check your API key")
            return None, False
        elif response.status_code == 429:
            print(f"Rate limit exceeded. Please wait or upgrade your plan")
            return None, False
        else:
            print(f"API Error {response.status_code}: {response.text[:200]}")
            return None, False

    except requests.exceptions.Timeout:
        print("Request timeout - model took too long to respond")
        return None, False
    except requests.exceptions.ConnectionError:
        print("Connection error - cannot reach Ollama Cloud")
        return None, False
    except Exception as e:
        print(f"Unexpected error: {e}")
        return None, False

# Test the connection
print("Testing connection to Ollama Cloud...")
test_prompt = "Respond with just 'OK'"
