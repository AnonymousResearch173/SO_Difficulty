# ============================================
# SIMPLIFIED PARSING FUNCTION
# ============================================

def extract_difficulty(response_text: str) -> Optional[str]:
    """Extract difficulty from response text"""
    try:
        # Clean the response
        response_text = response_text.strip().lower()

        # Remove any markdown or formatting
        response_text = re.sub(r'[`"\'{}]', '', response_text)
        response_text = re.sub(r'[^a-z]', ' ', response_text)
        response_text = ' '.join(response_text.split())

        # Check for difficulty keywords
        if 'basic' in response_text:
            return 'Basic'
        elif 'intermediate' in response_text:
            return 'Intermediate'
        elif 'advanced' in response_text:
            return 'Advanced'
        else:
            print(f"Could not extract difficulty from: {response_text[:100]}")
            return None

    except Exception as e:
        print(f"Error extracting difficulty: {e}")
        return None

# ============================================
# HELPER FUNCTIONS
# ============================================

def clean_text(text: str, max_length: int = 2000) -> str:
    """Clean and truncate text for API"""
    if pd.isna(text):
        return ""
    text = str(text)
    # Remove HTML tags
    text = re.sub(r'<[^>]+>', ' ', text)
    # Remove excessive whitespace
    text = re.sub(r'\s+', ' ', text)
    # Truncate if too long
    if len(text) > max_length:
        text = text[:max_length] + "..."
    return text.strip()

def make_request_with_retry(prompt: str, max_retries: int = 3) -> tuple:
    """Make API request with exponential backoff"""
    for attempt in range(max_retries):
        response_text, success = query_ollama_cloud(prompt)

        if success and response_text:
            return response_text, True

        wait_time = (2 ** attempt) + random.uniform(0, 1)
        print(f"Retry {attempt + 1}/{max_retries} after {wait_time:.2f}s...")
        time.sleep(wait_time)

    return None, False

# ============================================
# MAIN PROCESSING FUNCTION
# ============================================

def classify_questions_with_ollama_cloud(
    csv_path: str,
    text_column: str = "Body",
    output_column: str = "LLM Prediction",
    start_row: int = 0,
    end_row: Optional[int] = None,
    checkpoint_interval: int = 20,
    base_output_path: str = "ollama_cloud_results"
) -> pd.DataFrame:
    """Classify questions using Ollama Cloud API"""

    # Load CSV
    print(f"Loading CSV from {csv_path}...")
    df = pd.read_csv(csv_path)
    print(f"Loaded {len(df)} rows")

    # Check if required column exists
    if text_column not in df.columns:
        raise ValueError(f"Column '{text_column}' not found. Available: {df.columns.tolist()}")

    # Initialize output column if it doesn't exist
    if output_column not in df.columns:
        df[output_column] = None

    # Set end row
    if end_row is None:
        end_row = len(df)
    end_row = min(end_row, len(df))

    print(f"Processing rows {start_row} to {end_row-1}...")
    print(f"Using model: {MODEL_NAME}")

    # Track processed rows
    processed_count = 0
    error_count = 0

    # Main processing loop
    for idx in tqdm(range(start_row, end_row), desc="Classifying questions"):
        # Skip if already processed successfully
        if pd.notna(df.at[idx, output_column]) and df.at[idx, output_column] in ["Basic", "Intermediate", "Advanced"]:
            print(f"\nRow {idx} already processed, skipping...")
            continue

        # Get question text
        question_text = clean_text(df.at[idx, text_column])

        if not question_text or len(question_text) < 10:
            print(f"\nRow {idx}: Invalid text, marking as 'Unable to classify'")
            df.at[idx, output_column] = "Unable to classify"
            continue

        # Create prompt
        prompt = difficulty_prompt_template.format(question=question_text)

        # Make request with retry
        response_text, success = make_request_with_retry(prompt)

        if success and response_text:
            difficulty = extract_difficulty(response_text)

            if difficulty:
                df.at[idx, output_column] = difficulty
                processed_count += 1
                print(f"\n✓ Row {idx}: {difficulty}")
            else:
                df.at[idx, output_column] = "Parse Error"
                error_count += 1
                print(f"\n✗ Row {idx}: Parse error - {response_text[:100]}")
        else:
            # API request failed
            df.at[idx, output_column] = "API Error"
            error_count += 1
            print(f"\n✗ Row {idx}: API error")

        # Add delay to avoid rate limiting
        time.sleep(random.uniform(0.5, 1))

        # Save checkpoint
        if (idx + 1 - start_row) % checkpoint_interval == 0 and (idx + 1 - start_row) > 0:
            batch_num = (idx + 1 - start_row) // checkpoint_interval
            checkpoint_file = f"{base_output_path}_checkpoint_{batch_num}.csv"
            df.iloc[:idx+1].to_csv(checkpoint_file, index=False)
            print(f"\n💾 Checkpoint saved: {checkpoint_file}")

    # Save final results
    final_output = f"{base_output_path}_complete.csv"
    df.to_csv(final_output, index=False)

    # Print statistics
    print("\n" + "="*60)
    print("CLASSIFICATION COMPLETE")
    print("="*60)
    print(f"Successfully processed: {processed_count}")
    print(f"Errors: {error_count}")

    print(f"\nDifficulty Distribution:")
    valid_results = df[df[output_column].isin(["Basic", "Intermediate", "Advanced"])]
    if len(valid_results) > 0:
        distribution = valid_results[output_column].value_counts()
        for difficulty, count in distribution.items():
            percentage = (count / len(valid_results)) * 100
            print(f"  {difficulty}: {count} ({percentage:.1f}%)")

    print(f"\nResults saved to: {final_output}")

    return df

